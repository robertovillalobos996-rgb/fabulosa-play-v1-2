rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isFabulosaAdmin() {
      return request.auth != null
        && request.auth.token.email == "fabulosaplay@gmail.com";
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow create, update: if isFabulosaAdmin()
        && request.resource.size < 250 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
      allow delete: if isFabulosaAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
